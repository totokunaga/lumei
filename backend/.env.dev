# Local development environment, injected by dotenvx (see Makefile).
# Values here are plaintext because none are secret yet. Encrypt secrets with
# `dotenvx set KEY value -f .env.dev`; the private key goes to .env.keys, which
# is gitignored.

# Used by `make run` (the server runs on the host and reaches the compose
# database through its published port). The api container overrides these.
RDB_HOST=localhost
RDB_PORT=15432
RDB_NAME=lumei
RDB_SSL_MODE=disable

LOG_LEVEL=debug
LOG_FORMAT=text

# Sign-in (see AuthConfig in internal/config/config.go). Dev sign-in accepts
# any email without proof: never enable it in a deployed environment. Add the
# Apple bundle ID and the Google web client ID once they exist.
AUTH_DEV_SIGN_IN=true
# host.exp.Exponent is Expo Go's bundle ID: Apple issues tokens for it when
# you sign in from Expo Go. Development only: it accepts Apple tokens issued
# to anyone's Expo Go. Deployed environments list only Lumei's own bundle ID
# (and later its Services ID).
AUTH_APPLE_CLIENT_IDS=host.exp.Exponent
AUTH_GOOGLE_CLIENT_IDS=

# Signs access JWTs (ES256). This key is for local development only, so it is
# committed in plain text: anyone can read it, which is fine for a key that
# only signs tokens for your own machine. Deployed environments get their own
# key from Secrets Manager; generate one with:
#   openssl genpkey -algorithm EC -pkeyopt ec_paramgen_curve:P-256 | openssl pkcs8 -topk8 -nocrypt
AUTH_JWT_SIGNING_KEY="-----BEGIN PRIVATE KEY-----
MIGHAgEAMBMGByqGSM49AgEGCCqGSM49AwEHBG0wawIBAQQg/HqPyFta3HSAf+Pm
glSCjIV67vXpTuh+DYd1ZItfvlihRANCAASiSMDRkVM+XOI42xOsN7IlMyiZnFJl
xsHpReCzGu5BrgrZSa/sdc2jwWV6kPpXfAUfbZ8Hqj/VBFmyhB2dAiLV
-----END PRIVATE KEY-----"
