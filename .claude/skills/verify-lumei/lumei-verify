COMMANDS = {"up": cmd_up, "doctor": cmd_doctor, "ui": cmd_ui, "tap": cmd_tap, "wait": cmd_wait,
            "gone": cmd_gone, "type": cmd_type, "key": cmd_key, "swipe": cmd_swipe, "shot": cmd_shot,
            "sql": cmd_sql, "device-sql": cmd_device_sql, "note": cmd_note, "down": cmd_down,
